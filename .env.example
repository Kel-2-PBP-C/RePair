# Salin nilai ini ke .env existing; pertahankan konfigurasi database/secret existing.
PRODUCTION=False
DEBUG=True
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/accounts/google/callback/
GOOGLE_ONLY_AUTH=True
GOOGLE_ALLOW_REGISTRATION=True

# Email kontak PUBLIK tim untuk homepage dan kebijakan privasi. Isi sendiri.
PUBLIC_SUPPORT_EMAIL=

# API wilayah hanya dipakai backend. Isi key dari penyedia di .env/PWS Environs.
BOGORTECH_API_KEY=
# Opsional jika lingkungan memakai CA sistem tambahan; kosongkan di PWS kecuali diperlukan.
BOGORTECH_CA_BUNDLE=

# Hosting: PRODUCTION=True, DEBUG=False, callback HTTPS, secret Django persisten.
# DJANGO_SECRET_KEY=
# DJANGO_TRUST_PROXY_HTTPS=True
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# SCHEMA=public
